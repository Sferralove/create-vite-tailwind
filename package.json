{
  "name": "create-vite-tailwind",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --ext js,jsx",
    "test": "vitest",
    "test:run": "vitest run",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx}": [
